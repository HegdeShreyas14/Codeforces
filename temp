/*  FAST MATH  */
inline ll mod_add(ll a, ll b, ll m = MOD) {
    a += b;
    if (a >= m) a -= m;
    return a;
}

inline ll mod_sub(ll a, ll b, ll m = MOD) {
    a -= b;
    if (a < 0) a += m;
    return a;
}

inline ll mod_mul(ll a, ll b, ll m = MOD) {
    return (ll)((__int128)a * b % m);
}

ll mod_pow(ll a, ll e, ll m = MOD) {
    ll r = 1;
    while (e) {
        if (e & 1) r = mod_mul(r, a, m);
        a = mod_mul(a, a, m);
        e >>= 1;
    }
    return r;
}




